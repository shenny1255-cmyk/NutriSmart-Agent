// ER Diagram - NutriSmart Agent (Nhóm E15)
// Tái cấu trúc theo mô hình Table-per-Role; số đo thay đổi được lưu riêng theo lịch sử.
// Tổng: 25 bảng

// ==================== NHÓM USER & PHÂN QUYỀN ====================

[users]
    *id {label:"UUID"}
    email {label:"VARCHAR(255)"}
    password_hash {label:"VARCHAR(255)"}
    role {label:"user_role (USER/EXPERT/ADMIN)"}
    created_at {label:"TIMESTAMPTZ"}
    updated_at {label:"TIMESTAMPTZ"}

[user_profile]
    *user_id {label:"UUID (FK → users)"}
    full_name {label:"VARCHAR(150)"}
    gender {label:"VARCHAR(10)"}
    birth_date {label:"DATE"}
    activity_level_id {label:"SMALLINT (FK → activity_levels)"}
    goal {label:"VARCHAR(20)"}
    daily_calorie_target {label:"INTEGER"}
    created_at {label:"TIMESTAMPTZ"}
    updated_at {label:"TIMESTAMPTZ"}

[activity_levels]
    *id {label:"SMALLINT"}
    name {label:"VARCHAR(100) UNIQUE"}
    description {label:"VARCHAR(500)"}
    calorie_multiplier {label:"NUMERIC(4,3)"}

[staff_profiles]
    *user_id {label:"UUID (FK → users)"}
    staff_code {label:"VARCHAR(30)"}
    full_name {label:"VARCHAR(150)"}
    gender {label:"VARCHAR(10)"}
    birth_date {label:"DATE"}
    specialization {label:"VARCHAR(100)"}
    qualification {label:"VARCHAR(100)"}
    employment_status {label:"VARCHAR(20)"}
    created_at {label:"TIMESTAMPTZ"}
    updated_at {label:"TIMESTAMPTZ"}

[role_permissions]
    *role {label:"user_role"}
    can_manage_users {label:"BOOLEAN"}
    can_manage_foods {label:"BOOLEAN"}
    can_manage_categories {label:"BOOLEAN"}
    can_review_documents {label:"BOOLEAN"}
    can_review_plans {label:"BOOLEAN"}
    can_review_ai_chat {label:"BOOLEAN"}
    can_review_logs {label:"BOOLEAN"}
    can_manage_permissions {label:"BOOLEAN"}
    created_at {label:"TIMESTAMPTZ"}
    updated_at {label:"TIMESTAMPTZ"}

// ==================== BỆNH NỀN & DỊ ỨNG ====================

[medical_conditions]
    *id {label:"INTEGER"}
    name {label:"VARCHAR(150)"}

[allergens]
    *id {label:"INTEGER"}
    name {label:"VARCHAR(150)"}

[user_medical_conditions]
    *user_id {label:"UUID (FK → user_profile)"}
    *condition_id {label:"INTEGER (FK → medical_conditions)"}

[user_allergens]
    *user_id {label:"UUID (FK → user_profile)"}
    *allergen_id {label:"INTEGER (FK → allergens)"}

// ==================== THEO DÕI SỨC KHỎE ====================

[body_metrics_history]
    *id {label:"BIGINT"}
    user_id {label:"UUID (FK → users)"}
    recorded_at {label:"DATE"}
    height_cm {label:"NUMERIC(5,2)"}
    weight_kg {label:"NUMERIC(5,2)"}

[meal_logs]
    *id {label:"BIGINT"}
    user_id {label:"UUID (FK → users)"}
    food_id {label:"UUID (FK → foods)"}
    meal_image_id {label:"UUID (FK → meal_images)"}
    meal_type {label:"VARCHAR(9)"}
    quantity {label:"NUMERIC(6,2)"}
    calories_kcal {label:"NUMERIC(7,2)"}
    log_date {label:"DATE"}
    logged_at {label:"TIMESTAMPTZ"}

[activity_logs]
    *id {label:"BIGINT"}
    user_id {label:"UUID (FK → users)"}
    exercise_id {label:"INTEGER (FK → exercises)"}
    duration_min {label:"INTEGER"}
    calories_burned {label:"NUMERIC(7,2)"}
    steps {label:"INTEGER"}
    started_at {label:"TIMESTAMPTZ"}
    ended_at {label:"TIMESTAMPTZ"}
    logged_at {label:"TIMESTAMPTZ"}

// ==================== THỰC PHẨM & BÀI TẬP ====================

[foods]
    *id {label:"UUID"}
    name {label:"VARCHAR(200)"}
    calories_kcal {label:"NUMERIC(7,2)"}
    protein_g {label:"NUMERIC(6,2)"}
    carb_g {label:"NUMERIC(6,2)"}
    fat_g {label:"NUMERIC(6,2)"}
    serving_gram {label:"NUMERIC(7,2)"}
    serving_desc {label:"VARCHAR(100)"}
    source {label:"VARCHAR(100)"}

[exercises]
    *id {label:"INTEGER"}
    name {label:"VARCHAR(150)"}
    category {label:"VARCHAR(80)"}
    met_value {label:"NUMERIC(4,2)"}

[meal_images]
    *id {label:"UUID"}
    user_id {label:"UUID (FK → users)"}
    image_path {label:"TEXT"}
    predicted_food_id {label:"UUID (FK → foods)"}
    estimated_kcal {label:"NUMERIC(7,2)"}
    confidence {label:"NUMERIC(4,3)"}
    raw_prediction {label:"JSONB"}
    suitability_note {label:"TEXT"}
    status {label:"VARCHAR(7)"}
    created_at {label:"TIMESTAMPTZ"}

// ==================== LỘ TRÌNH DINH DƯỠNG ====================

[nutrition_plans]
    *id {label:"UUID"}
    user_id {label:"UUID (FK → users)"}
    version {label:"INTEGER"}
    status {label:"plan_status"}
    goal {label:"goal_enum"}
    daily_kcal_target {label:"INTEGER"}
    content {label:"JSONB"}
    start_date {label:"DATE"}
    end_date {label:"DATE"}
    created_at {label:"TIMESTAMPTZ"}

[plan_evaluations]
    *id {label:"BIGINT"}
    plan_id {label:"UUID (FK → nutrition_plans)"}
    period_start {label:"DATE"}
    period_end {label:"DATE"}
    avg_kcal_intake {label:"NUMERIC(8,2)"}
    weight_change_kg {label:"NUMERIC(5,2)"}
    result {label:"VARCHAR(12)"}
    ai_feedback {label:"TEXT"}
    evaluated_at {label:"TIMESTAMPTZ"}

// ==================== TÀI LIỆU RAG ====================

[doc_categories]
    *id {label:"INTEGER"}
    name {label:"VARCHAR(150)"}
    slug {label:"VARCHAR(150)"}
    parent_id {label:"INTEGER (FK → doc_categories)"}

[documents]
    *id {label:"UUID"}
    uploaded_by {label:"UUID (FK → users)"}
    approved_by {label:"UUID (FK → users)"}
    category_id {label:"INTEGER (FK → doc_categories)"}
    title {label:"TEXT"}
    raw_text {label:"TEXT"}
    file_path {label:"TEXT"}
    source_name {label:"VARCHAR(150)"}
    source_url {label:"TEXT"}
    language {label:"VARCHAR(10)"}
    status {label:"VARCHAR(8)"}
    created_at {label:"TIMESTAMPTZ"}
    approved_at {label:"TIMESTAMPTZ"}
    deleted_at {label:"TIMESTAMPTZ"}

[doc_chunks]
    *id {label:"BIGINT"}
    document_id {label:"UUID (FK → documents)"}
    chunk_index {label:"INTEGER"}
    content {label:"TEXT"}
    token_count {label:"INTEGER"}
    embedding {label:"VECTOR(1024)"}
    metadata {label:"JSONB"}

// ==================== CHAT AI ====================

[chat_sessions]
    *id {label:"UUID"}
    user_id {label:"UUID (FK → users)"}
    title {label:"VARCHAR(255)"}
    created_at {label:"TIMESTAMPTZ"}

[chat_messages]
    *id {label:"INTEGER"}
    session_id {label:"UUID (FK → chat_sessions)"}
    role {label:"VARCHAR(20)"}
    content {label:"TEXT"}
    flagged {label:"BOOLEAN"}
    created_at {label:"TIMESTAMPTZ"}

[message_citations]
    *message_id {label:"BIGINT (FK → chat_messages)"}
    *chunk_id {label:"BIGINT (FK → doc_chunks)"}
    score {label:"NUMERIC(5,4)"}
    rank {label:"SMALLINT"}

// ==================== HỆ THỐNG ====================

[notifications]
    *id {label:"BIGINT"}
    user_id {label:"UUID (FK → users)"}
    title {label:"VARCHAR(200)"}
    body {label:"TEXT"}
    type {label:"VARCHAR(50)"}
    is_read {label:"BOOLEAN"}
    created_at {label:"TIMESTAMPTZ"}

[audit_logs]
    *id {label:"BIGINT"}
    actor_id {label:"UUID (FK → users)"}
    action {label:"VARCHAR(50)"}
    entity {label:"VARCHAR(80)"}
    entity_id {label:"TEXT"}
    before_data {label:"JSONB"}
    after_data {label:"JSONB"}
    ip_address {label:"INET"}
    created_at {label:"TIMESTAMPTZ"}

// ==================== RELATIONSHIPS ====================

users 1--1 user_profile
activity_levels 1--* user_profile
users 1--? staff_profiles
role_permissions 1--* users

user_profile 1--* user_medical_conditions
medical_conditions 1--* user_medical_conditions
user_profile 1--* user_allergens
allergens 1--* user_allergens

users 1--* body_metrics_history
users 1--* meal_logs
foods ?--* meal_logs
meal_images ?--* meal_logs
users 1--* activity_logs
exercises ?--* activity_logs
users 1--* meal_images
foods ?--* meal_images

users 1--* nutrition_plans
nutrition_plans 1--* plan_evaluations

doc_categories ?--* doc_categories
doc_categories ?--* documents
users ?--* documents
users ?--* documents
documents 1--* doc_chunks

users 1--* chat_sessions
chat_sessions 1--* chat_messages
chat_messages 1--* message_citations
doc_chunks 1--* message_citations

users 1--* notifications
users ?--* audit_logs
