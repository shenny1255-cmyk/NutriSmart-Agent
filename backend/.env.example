# NutriSmart Agent - Environment Variables Example

# Database Connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/nutrismart

# Security
SECRET_KEY=nutrismart-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini Flash AI Vision Key (Lấy key miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# AI Provider Adapter (services/llm.py)
# ollama = tự host, dữ liệu không rời máy chủ (mặc định) | gemini = cloud, máy khách không cần cài Ollama
LLM_PROVIDER=ollama
# Gemini lỗi/hết quota thì tự chuyển sang Ollama nội bộ
LLM_FALLBACK_LOCAL=true
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
