# ==============================================================================
# NutriSmart Agent - Environment Variables Example
# ==============================================================================

# 1. Database Connection (PostgreSQL 16 + pgvector)
# Local: postgresql+psycopg2://postgres:postgres@localhost:5433/nutrismart
# Cloud (Supabase/Neon.tech): Dán Connection String URI được cấp từ Dashboard (Transaction pooler hoặc Session)
# Lưu ý: Nếu chuỗi kết nối bắt đầu bằng postgres://, backend sẽ tự động chuyển thành postgresql://
DATABASE_URL=postgresql+psycopg2://username:password@ep-sample-pooler.region.neon.tech/nutrismart?sslmode=require

# 2. Security & JWT
# Khóa bí mật dùng để ký token JWT (nên tạo chuỗi ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=production

# 3. CORS Configuration
# Domain của frontend Vercel hoặc domain tuỳ chỉnh (phân cách bằng dấu phẩy)
# Lưu ý: Backend đã tích hợp sẵn regex cho phép tất cả domain *.vercel.app và localhost
CORS_ORIGINS=https://nutrismart-frontend.vercel.app,http://localhost:5173

# 4. AI Provider (LLM & Vision)
# Khi deploy lên Render (Free Tier không chạy được Ollama), BẮT BUỘC dùng Cloud Gemini:
LLM_PROVIDER=gemini
LLM_FALLBACK_LOCAL=false
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_CHAT_MODEL=gemini-2.5-flash

# (Tùy chọn: Nếu chạy local với Ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=gemma3:1b

# 5. Base URL cho Frontend (dùng cho link xác minh email nếu cấu hình SMTP)
APP_BASE_URL=https://nutrismart-frontend.vercel.app

# 6. SMTP Email Verification (Để trống nếu không dùng email thật, backend sẽ in link ra log console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriSmart <no-reply@nutrismart.vn>
