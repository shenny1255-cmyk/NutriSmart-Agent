# NutriSmart Agent - Environment Variables Example

# Database Connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/nutrismart

# Security
SECRET_KEY=nutrismart-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini Flash AI Vision Key (Lấy key miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
